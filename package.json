{
  "name": "vite-project",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc -b && vite build",
    "format:check": "biome format .",
    "format:fix": "biome format --write .",
    "lint:check": "biome lint .",
    "lint:fix": "biome lint --fix .",
    "knip:check": "knip",
    "type:check": "npm run type:check:app && npm run type:check:test",
    "type:check:app": "tsc --project tsconfig.app.json --noEmit",
    "type:check:test": "tsc --project tsconfig.test.json --noEmit",
    "preview": "vite preview",
    "test:unit": "vitest --project unit --run",
    "test:unit:watch": "vitest --project unit",
    "test:component": "vitest --project component --run",
    "test:component:watch": "vitest --project component",
    "test:integration": "vitest --project integration --run",
    "test:integration:watch": "vitest --project integration",
    "test:e2e": "cypress open",
    "test:all": "npm run test:unit && npm run test:component && npm run test:integration",
    "test:coverage": "vitest --run --coverage"
  },
  "dependencies": {
    "@ant-design/icons": "^6.1.0",
    "@faker-js/faker": "^10.3.0",
    "@hookform/resolvers": "^5.2.2",
    "antd": "^6.3.3",
    "react": "^19.2.4",
    "react-dom": "^19.2.4",
    "react-hook-form": "^7.71.2",
    "zod": "^4.3.6",
    "zustand": "^5.0.11"
  },
  "devDependencies": {
    "@biomejs/biome": "^2.4.7",
    "@testing-library/jest-dom": "^6.9.1",
    "@testing-library/react": "^16.3.2",
    "@testing-library/user-event": "^14.6.1",
    "@types/node": "^25.5.0",
    "@types/react": "^19.2.14",
    "@types/react-dom": "^19.1.9",
    "@vitejs/plugin-react": "^5.1.4",
    "@vitest/coverage-v8": "^4.0.18",
    "babel-plugin-react-compiler": "^1.0.0",
    "cypress": "^15.10.0",
    "globals": "^17.3.0",
    "happy-dom": "^20.8.3",
    "knip": "^5.86.0",
    "typescript": "~5.9.3",
    "vite": "^7.3.1",
    "vitest": "^4.0.18"
  }
}
